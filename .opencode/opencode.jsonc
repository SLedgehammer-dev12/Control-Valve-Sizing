{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "orchestrator": {
      "permission": {
        "skill": {
          "*": "allow"
        },
        "agent": {
          "*": "allow"
        },
        "edit": "ask"
      }
    },
    "cv-orchestrator": {
      "permission": {
        "skill": {
          "*": "allow"
        },
        "agent": {
          "*": "allow"
        },
        "edit": "ask"
      }
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
